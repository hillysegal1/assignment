# Copy this file to .env and paste your own Kaggle API token after the = sign.
# .env is listed in .gitignore, so your token is never committed.
#
# Create a token at https://www.kaggle.com/settings -> API -> "Create New Token",
# and accept the competition rules at https://www.kaggle.com/competitions/titanic/rules
KAGGLE_API_TOKEN=
